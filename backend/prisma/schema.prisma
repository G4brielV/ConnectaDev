generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  sessions            Session[]
  accounts            Account[]
  passwordResetTokens PasswordResetToken[]

  profile          UserProfile?
  diagnosis        VocationalDiagnosis?
  courseBookmarks  UserCourseBookmark[]
  gamification     UserGamification?
  reviewSessions   KnowledgeReviewSession[]
  trailProgress    UserTrailProgress[]
  xpEvents         XpEvent[]
  activityDays     UserActivityDay[]
  courseRatings    CourseRating[]
  practiceSessions TrailPracticeSession[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  issuer                String

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model UserProfile {
  userId            String   @id @map("user_id")
  bio               String?
  avatarUrl         String?  @map("avatar_url")
  phoneNumber       String?  @map("phone_number")
  educationStage    String   @default("ENSINO_MEDIO_3") @map("education_stage")
  targetInstitution String?  @map("target_institution")
  targetCareer      String?  @map("target_career")
  city              String   @default("Recife")
  neighborhood      String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model QuizQuestion {
  id         String   @id @default(uuid())
  statement  String
  type       String
  sequence   Int
  isActive   Boolean  @default(true) @map("is_active")
  options    Json?
  validation Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive, sequence])
  @@map("quiz_questions")
}

model VocationalDiagnosis {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  areaPrincipal        String   @map("area_principal")
  areasSecundarias     Json     @default("[]") @map("areas_secundarias")
  tecnologiasSugeridas Json     @map("tecnologias_sugeridas")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vocational_diagnoses")
}

model Course {
  id             String                @id @default(uuid())
  thumbnail      String
  title          String
  provider       String
  level          String
  externalUrl    String                @map("external_url")
  tags           Json
  areas          Json
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  bookmarks      UserCourseBookmark[]
  ratings        CourseRating[]
  trailResources TrailLessonResource[]

  @@index([isActive])
  @@map("courses")
}

model Topic {
  id          String   @id @default(uuid())
  title       String
  description String?
  sequence    Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  questions      KnowledgeReviewQuestion[]
  reviewSessions KnowledgeReviewSession[]

  @@map("topics")
}

model KnowledgeReviewQuestion {
  id              String   @id @default(uuid())
  topicId         String   @map("topic_id")
  statement       String
  sequence        Int      @default(1)
  options         Json
  correctOptionId String   @map("correct_option_id")
  explanation     String
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, isActive, sequence])
  @@map("knowledge_review_questions")
}

model KnowledgeReviewSession {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  topicId        String    @map("topic_id")
  status         String    @default("IN_PROGRESS")
  score          Int?
  totalQuestions Int       @map("total_questions")
  xpEarned       Int?      @map("xp_earned")
  answers        Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId])
  @@map("knowledge_review_sessions")
}

model CourseRating {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  courseId       String   @map("course_id")
  rating         Int
  comment        String?
  matchedProfile Boolean? @map("matched_profile")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_ratings")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Trail {
  id          String        @id @default(uuid())
  title       String
  description String?
  area        String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lessons     TrailLesson[]
  units       TrailUnit[]

  @@index([isActive])
  @@map("trails")
}

// Agrupa fases em unidades ("Unidade 2: Logica & JS Moderno" no mapa da trilha)
model TrailUnit {
  id        String        @id @default(uuid())
  trailId   String        @map("trail_id")
  title     String
  sequence  Int
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  trail     Trail         @relation(fields: [trailId], references: [id], onDelete: Cascade)
  lessons   TrailLesson[]

  @@unique([trailId, sequence])
  @@index([trailId, isActive])
  @@map("trail_units")
}

model TrailLesson {
  id           String                @id @default(uuid())
  trailId      String                @map("trail_id")
  unitId       String?               @map("unit_id")
  title        String
  description  String?
  sequence     Int
  // STANDARD | BONUS | BOSS — o bau bonus e o chefao do mapa
  kind         String                @default("STANDARD")
  // % minimo de acerto para aprovar e liberar a fase seguinte
  passingScore Int                   @default(60) @map("passing_score")
  // Mesmo vocabulario de `courses.tags`: liga a fase aos cursos extras recomendados
  tags         String[]              @default([])
  xpReward     Int                   @map("xp_reward")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  trail        Trail                 @relation(fields: [trailId], references: [id], onDelete: Cascade)
  unit         TrailUnit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions    TrailQuestion[]
  resources    TrailLessonResource[]
  userProgress UserTrailProgress[]

  @@unique([trailId, sequence])
  @@index([trailId, isActive])
  @@index([unitId, sequence])
  @@map("trail_lessons")
}

// Videos/cursos recomendados dentro de uma fase
model TrailLessonResource {
  id        String      @id @default(uuid())
  lessonId  String      @map("lesson_id")
  courseId  String?     @map("course_id")
  title     String
  url       String
  // Canal/autor do conteudo, exibido no card (ex.: "Curso em Video")
  provider  String?
  // VIDEO | COURSE | ARTICLE
  kind      String      @default("VIDEO")
  sequence  Int
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  lesson    TrailLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([lessonId, sequence])
  @@index([lessonId])
  @@map("trail_lesson_resources")
}

model TrailQuestion {
  id            String              @id @default(uuid())
  lessonId      String              @map("lesson_id")
  statement     String
  type          String
  sequence      Int
  options       Json?
  validation    Json?
  correctAnswer String              @map("correct_answer")
  explanation   String?
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  lesson        TrailLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  practiceItems TrailPracticeItem[]

  @@unique([lessonId, sequence])
  @@index([lessonId, isActive])
  @@map("trail_questions")
}

// Pratica do dia: sessao curta com perguntas da fase atual + revisao das concluidas
model TrailPracticeSession {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  correctCount Int                 @default(0) @map("correct_count")
  xpEarned     Int                 @default(0) @map("xp_earned")
  // Dia (Recife) em que esta sessao levou o XP da pratica. O unique garante uma
  // por dia mesmo com dois envios simultaneos (NULLs nao colidem no Postgres)
  rewardedDay  DateTime?           @map("rewarded_day") @db.Date
  completedAt  DateTime?           @map("completed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        TrailPracticeItem[]

  @@unique([userId, rewardedDay])
  @@index([userId, createdAt])
  @@map("trail_practice_sessions")
}

// Pergunta sorteada numa sessao de pratica; vale a primeira resposta
model TrailPracticeItem {
  id               String               @id @default(uuid())
  sessionId        String               @map("session_id")
  questionId       String               @map("question_id")
  sequence         Int
  selectedOptionId String?              @map("selected_option_id")
  isCorrect        Boolean?             @map("is_correct")
  answeredAt       DateTime?            @map("answered_at")
  session          TrailPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         TrailQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@unique([sessionId, sequence])
  @@index([questionId])
  @@map("trail_practice_items")
}

model UserGamification {
  userId           String    @id @map("user_id")
  totalXp          Int       @default(0) @map("total_xp")
  currentLevel     Int       @default(1) @map("current_level")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_gamification")
}

model XpEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  source      String
  referenceId String   @map("reference_id")
  amount      Int
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, source, referenceId, createdAt])
  @@map("xp_events")
}

// Um registro por dia de estudo (dia de Recife): o histórico do calendário da ofensiva
model UserActivityDay {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("user_activity_days")
}

model UserTrailProgress {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  lessonId       String      @map("lesson_id")
  attempts       Int         @default(0)
  bestCorrect    Int         @default(0) @map("best_correct")
  totalQuestions Int         @default(0) @map("total_questions")
  xpAwarded      Int         @default(0) @map("xp_awarded")
  // Aprovacao no gate: percentual >= lesson.passingScore
  passed         Boolean     @default(false)
  bestPercentage Int         @default(0) @map("best_percentage")
  // 0-3 estrelas conforme o melhor desempenho
  stars          Int         @default(0)
  completedAt    DateTime?   @map("completed_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         TrailLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("user_trail_progress")
}

model UserCourseBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("user_course_bookmarks")
}
