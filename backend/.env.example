PORT=3000
DATABASE_URL="postgresql://usuario:senha@localhost:5433/trilhatech_db?schema=public"
BETTER_AUTH_SECRET="sua_chave_secreta_aqui"
BETTER_AUTH_URL="http://localhost:3000"
# Provedor de IA principal: groq (com fallback automático para gemini)
AI_PROVIDER="groq"           # groq | xai | gemini

# Groq (principal): tier gratuito, inferência ultrarrápida
GROQ_API_KEY="sua_chave_groq_aqui"
GROQ_MODEL="openai/gpt-oss-120b"

# xAI (Grok) — exige créditos na conta, não tem tier gratuito
XAI_API_KEY="sua_chave_xai_aqui"
XAI_MODEL="grok-build-0.1"

# Gemini (fallback automático caso Groq falhe, ou direto via AI_PROVIDER=gemini)
GEMINI_API_KEY="sua_chave_gemini_aqui"
GEMINI_MODEL="gemini-3.5-flash-lite"
JOOBLE_API_KEY="sua_chave_jooble_aqui"
ADMIN_SYNC_TOKEN="defina_um_token_administrativo_forte"
# Todos os dias às 03:00 no horário de Recife
JOBS_SYNC_CRON="0 3 * * *"
JOBS_SYNC_TIMEZONE="America/Recife"
JOBS_SYNC_RUN_ON_START="true"