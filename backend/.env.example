PORT=3000
DATABASE_URL="postgresql://usuario:senha@localhost:5433/trilhatech_db?schema=public"
BETTER_AUTH_SECRET="sua_chave_secreta_aqui"
BETTER_AUTH_URL="http://localhost:3000"
# Provedor de IA usado na geração de perguntas e na análise do quiz vocacional
AI_PROVIDER="groq"           # groq | xai | gemini

# Groq (padrão): tier gratuito, ~4s para gerar uma prova de 10 questões
GROQ_API_KEY="sua_chave_groq_aqui"
GROQ_MODEL="openai/gpt-oss-120b"

# xAI (Grok) — exige créditos na conta, não tem tier gratuito
XAI_API_KEY="sua_chave_xai_aqui"
XAI_MODEL="grok-build-0.1"

# Gemini (alternativa, usada quando AI_PROVIDER=gemini)
GEMINI_API_KEY="sua_chave_gemini_aqui"
GEMINI_MODEL="gemini-3.5-flash-lite"
GROQ_API_KEY="sua_chave_groq_aqui"
GROQ_MODEL="llama-3.3-70b-versatile"
JOOBLE_API_KEY="sua_chave_jooble_aqui"
JOBS_SYNC_INTERVAL_MS="43200000"
